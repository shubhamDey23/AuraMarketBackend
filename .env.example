# Environment Configuration for AuraMarket Microservices Backend
# Copy to .env for local development. Never use these defaults in production.

# PostgreSQL Configuration
POSTGRES_DB=postgres
POSTGRES_USER=auramarket_user
POSTGRES_PASSWORD=local_dev_only_change_me
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_HOST_PORT=9092
KAFKA_UI_PORT=8092

# API Gateway / Frontend
FRONTEND_ORIGIN=http://localhost:4200

# JWT Security: replace before use and supply production secrets via a secret manager.
JWT_SECRET=replace_with_a_64_character_random_secret_before_starting
JWT_EXPIRATION_MS=86400000

# Google OAuth2 Preparation
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
