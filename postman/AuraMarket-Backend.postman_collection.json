    {
      "name": "02 - Authentication",
      "description": "User registration, login, JWT token generation, refresh, and password changes.",
      "item": [
        {
          "name": "Register Customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tenantCode\": \"AURA_AYURVEDA\",\n  \"email\": \"customer_test_{{$randomInt}}@auramarket.local\",\n  \"password\": \"Password@123\",\n  \"firstName\": \"Test\",\n  \"lastName\": \"Customer\",\n  \"role\": \"CUSTOMER\"\n}"
            },
            "url": {
              "raw": "{{gatewayUrl}}/api/v1/auth/register",
              "host": [
