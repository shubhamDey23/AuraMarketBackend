              ],
              "path": [
                "api",
                "v1",
                "auth",
                "register"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201', function () { pm.response.to.have.status(201); });",
                  "var res = pm.response.json();",
                  "if (res.data && res.data.accessToken) { pm.environment.set('customerAccessToken', res.data.accessToken); pm.environment.set('customerId', res.data.user.id); }"
                ],
                "type": "text/javascript"
              }
            }
